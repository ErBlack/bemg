{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": false,
        "outDir": "dist",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "include": ["bin", "lib", "__mocks__"],
    "exclude": ["**/*.test.js"]
}
