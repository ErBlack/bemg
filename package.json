{
  "name": "bemg",
  "version": "3.4.1",
  "description": "bem generator",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErBlack/bemg"
  },
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=9.5"
  },
  "bin": {
    "bemg": "bin/bemg.js"
  },
  "scripts": {
    "docs": "node docs.js > README.md",
    "test": "vitest run",
    "fix": "prettier --log-level warn --write .",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run test",
    "version": "npm run docs && git add README.md",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "bemg",
    "bin",
    "lib"
  ],
  "keywords": [
    "bem",
    "mcp"
  ],
  "author": "ErBlack",
  "license": "MPL-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
